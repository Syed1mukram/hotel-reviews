{
  "manifest_version": 3,
  "name": "Expedia Hotel Research",
  "version": "0.3.6",
  "description": "Extract structured hotel research data from Expedia pages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.expedia.com/*",
    "https://*.expedia.com/*"
  ],
  "action": {
    "default_title": "Hotel Research",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.expedia.com/*",
        "https://*.expedia.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}